{
  "entities": {
    "user": {
      "title": "User",
      "description": "User profile for staff and administrators",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "format": "email", "description": "User email address" },
        "name": { "type": "string", "description": "User display name" },
        "role": { "type": "string", "enum": ["Admin", "Content Editor", "Enquiry Manager"], "description": "Access control role" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" }
      },
      "required": ["uid", "email", "role"]
    },
    "enquiry": {
      "title": "Enquiry",
      "description": "Client hardware engineering project submission",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique enquiry ID" },
        "fullName": { "type": "string", "description": "Full name of the contact person" },
        "email": { "type": "string", "format": "email", "description": "Contact email" },
        "phone": { "type": "string", "description": "Contact phone number" },
        "orgName": { "type": "string", "description": "Organization or venture name" },
        "category": { "type": "string", "description": "Engineering or ecosystem category" },
        "currentStage": { "type": "string", "description": "Current hardware readiness stage" },
        "projectDescription": { "type": "string", "description": "Technical project description" },
        "supportNeeded": { "type": "string", "description": "Specific prototyping or manufacturing support required" },
        "preferredContactMethod": { "type": "string", "enum": ["Email", "Phone", "WhatsApp"], "description": "Preferred contact mode" },
        "consent": { "type": "boolean", "description": "User consent to technical review" },
        "status": { "type": "string", "enum": ["New", "Contacted", "Under Review", "In Progress", "Closed"], "description": "Internal triage status" },
        "assignedTo": { "type": "string", "description": "Assigned staff member" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Submission timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last update timestamp" }
      },
      "required": ["fullName", "email", "category", "currentStage", "projectDescription"]
    },
    "program": {
      "title": "Program",
      "description": "Accelerator or cohort curriculum",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique program ID" },
        "title": { "type": "string", "description": "Program title" },
        "category": { "type": "string", "description": "Focus domain" },
        "description": { "type": "string", "description": "Curriculum overview" },
        "duration": { "type": "string", "description": "Track duration" },
        "format": { "type": "string", "description": "Delivery format" },
        "status": { "type": "string", "enum": ["active", "draft", "upcoming", "archived"], "description": "Publication status" },
        "applicationDeadline": { "type": "string", "description": "Application deadline" },
        "cohortStartDate": { "type": "string", "description": "Cohort start date" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last update timestamp" }
      },
      "required": ["title", "category", "description", "duration", "format", "status"]
    },
    "event": {
      "title": "Event",
      "description": "Builder meetups, demo days, and hardware teardowns",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique event ID" },
        "title": { "type": "string", "description": "Event title" },
        "description": { "type": "string", "description": "Event agenda and scope" },
        "category": { "type": "string", "description": "Event category" },
        "dateTime": { "type": "string", "description": "Event scheduled date and time" },
        "timezone": { "type": "string", "description": "Event timezone" },
        "venueOrLink": { "type": "string", "description": "Physical venue or virtual meeting link" },
        "isOnline": { "type": "boolean", "description": "Whether event is held online" },
        "bannerUrl": { "type": "string", "description": "Event banner image URL" },
        "registrationUrl": { "type": "string", "description": "External or direct registration link" },
        "status": { "type": "string", "enum": ["upcoming", "completed", "draft"], "description": "Event lifecycle status" },
        "registrationsCount": { "type": "number", "description": "Registered attendee count" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last update timestamp" }
      },
      "required": ["title", "description", "category", "dateTime", "venueOrLink", "registrationUrl", "status"]
    },
    "partnership": {
      "title": "Partnership",
      "description": "Strategic institutional, academic, or manufacturing partnership",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique partnership ID" },
        "orgName": { "type": "string", "description": "Organization name" },
        "contactPerson": { "type": "string", "description": "Representative contact name" },
        "email": { "type": "string", "format": "email", "description": "Representative contact email" },
        "type": { "type": "string", "description": "Partnership category" },
        "message": { "type": "string", "description": "Collaboration scope and proposal" },
        "status": { "type": "string", "enum": ["review", "approved", "active", "archived"], "description": "Vetting status" },
        "isPublic": { "type": "boolean", "description": "Whether to display in public partners directory" },
        "logoUrl": { "type": "string", "description": "Organization logo URL" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last update timestamp" }
      },
      "required": ["orgName", "type", "message", "status"]
    },
    "siteContent": {
      "title": "SiteContent",
      "description": "Dynamic homepage headlines and global site settings",
      "type": "object",
      "properties": {
        "heroHeadline": { "type": "string", "description": "Hero section headline" },
        "heroSupporting": { "type": "string", "description": "Hero section supporting text" },
        "visionHeadline": { "type": "string", "description": "Vision section headline" },
        "visionDescription": { "type": "string", "description": "Vision section description" },
        "logoUrl": { "type": "string", "description": "Custom logo image URL or base64 data URI" },
        "logoAlt": { "type": "string", "description": "Alternative text for custom logo" },
        "logoHeight": { "type": "number", "description": "Display height of custom logo in pixels" },
        "logoSubtitle": { "type": "string", "description": "Tagline displayed beneath custom logo" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last update timestamp" }
      },
      "required": ["heroHeadline", "heroSupporting", "visionHeadline", "visionDescription"]
    },
    "auditLog": {
      "title": "AuditLog",
      "description": "Administrative actions audit log",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique log ID" },
        "timestamp": { "type": "string", "format": "date-time", "description": "Event timestamp" },
        "actorEmail": { "type": "string", "format": "email", "description": "Email of the actor" },
        "actorRole": { "type": "string", "description": "Role of the actor" },
        "action": { "type": "string", "description": "Action performed" },
        "entity": { "type": "string", "description": "Entity affected" },
        "details": { "type": "string", "description": "Summary of changes" }
      },
      "required": ["timestamp", "actorEmail", "action", "entity"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "user",
      "description": "User profiles for authenticated staff and administrators"
    },
    "/enquiries/{enquiryId}": {
      "schema": "enquiry",
      "description": "Hardware engineering enquiries submitted by prospects and founders"
    },
    "/programs/{programId}": {
      "schema": "program",
      "description": "Hardware accelerator programs and cohort curriculum"
    },
    "/events/{eventId}": {
      "schema": "event",
      "description": "Community events, summits, and builder meetups"
    },
    "/partnerships/{partnershipId}": {
      "schema": "partnership",
      "description": "Strategic ecosystem and manufacturing partnerships"
    },
    "/site_content/{contentId}": {
      "schema": "siteContent",
      "description": "Dynamic homepage content and headlines"
    },
    "/audit_logs/{logId}": {
      "schema": "auditLog",
      "description": "Operations and security audit trail"
    }
  }
}
